---
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import { foto } from '../lib/fotos';
import '@fontsource-variable/montserrat/wght.css';
import '@fontsource-variable/montserrat/wght-italic.css';
import '../styles/global.css';

const url = new URL(Astro.url.pathname, site.url).href;
const fotoCompartir = foto(site.imagenes.compartir);
const og = fotoCompartir
  ? await getImage({ src: fotoCompartir, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 })
  : undefined;
const ogUrl = og ? new URL(og.src, site.url).href : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.seo.titulo}</title>
    <meta name="description" content={site.seo.descripcion} />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#ECE8E1" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={site.marca} />
    <meta property="og:title" content={site.seo.titulo} />
    <meta property="og:description" content={site.seo.descripcion} />
    <meta property="og:url" content={url} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    {ogUrl && <meta property="og:image:alt" content={`${site.marca} — ${site.nombre}`} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.seo.titulo} />
    <meta name="twitter:description" content={site.seo.descripcion} />
    {ogUrl && <meta name="twitter:image" content={ogUrl} />}

    <script is:inline>document.documentElement.classList.add('js');</script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'ProfessionalService',
        name: site.marca,
        description: site.seo.descripcion,
        url: site.url,
        email: site.contacto.email,
        telephone: site.contacto.whatsappVisible,
        founder: { '@type': 'Person', name: site.nombre, jobTitle: 'Fotógrafa y filmmaker' },
        address: { '@type': 'PostalAddress', addressLocality: 'Tigre', addressRegion: 'Buenos Aires', addressCountry: 'AR' },
        sameAs: [
          ...site.contacto.instagram.map((u) => `https://www.instagram.com/${u}/`),
          ...site.contacto.tiktok.map((u) => `https://www.tiktok.com/@${u}`),
        ],
      })}
    />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
