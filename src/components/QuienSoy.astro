---
import { Picture } from 'astro:assets';
import { site } from '../data/site';
import { foto } from '../lib/fotos';
const retrato = foto(site.imagenes.quienSoy);
const q = site.quienSoy;
---

<section id="quien-soy" class="quien">
  {
    retrato && (
      <div class="quien__foto reveal">
        <Picture
          src={retrato}
          alt={`Retrato de ${site.nombre} sosteniendo su cámara`}
          formats={['avif', 'webp']}
          widths={[400, 700, 1000]}
          sizes="(min-width: 900px) 40vw, 100vw"
        />
      </div>
    )
  }
  <div class="quien__texto reveal">
    <p class="label">Quién soy</p>
    <h2 class="quien__titulo">{q.titulo}</h2>
    {q.parrafos.map((p, i) => <p class={i === 0 ? 'quien__lead' : undefined}>{p}</p>)}
    <p><em>{q.cierre}</em></p>
  </div>
  {
    site.quienSoy.video && (
      <div class="quien__video" aria-hidden="true">
        <video
          poster={site.quienSoy.video.replace(/\.mp4$/, '.jpg')}
          muted
          loop
          playsinline
          preload="none"
          data-loop
        >
          <source src={site.quienSoy.video.replace(/\.mp4$/, '.webm')} type="video/webm" />
          <source src={site.quienSoy.video} type="video/mp4" />
        </video>
      </div>
    )
  }
</section>

<script>
  // El video de presentación arranca solo (sin sonido) cuando aparece en
  // pantalla y se pausa al salir. Con "reducir movimiento" queda la imagen fija.
  const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLVideoElement>('video[data-loop]').forEach((v) => {
    if (quieto || !('IntersectionObserver' in window)) return;
    v.preload = 'auto';
    new IntersectionObserver(
      ([e]) => (e.isIntersecting ? v.play().catch(() => {}) : v.pause()),
      { rootMargin: '200px 0px' },
    ).observe(v);
  });
</script>
