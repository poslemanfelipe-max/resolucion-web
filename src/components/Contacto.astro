---
import { site } from '../data/site';
const c = site.contacto;
---

<section id="contacto" class="contacto" aria-labelledby="titulo-contacto">
  <h2 id="titulo-contacto" class="contacto__titulo reveal">Trabajemos<br />juntos</h2>
  <dl class="contacto__lista reveal">
    <div>
      <dt class="label">Mail</dt>
      <dd><a href={`mailto:${c.email}`}>{c.email}</a></dd>
    </div>
    <div>
      <dt class="label">Instagram</dt>
      {c.instagram.map((u) => <dd><a href={`https://www.instagram.com/${u}/`} target="_blank" rel="noopener">@{u}</a></dd>)}
    </div>
    <div>
      <dt class="label">TikTok</dt>
      {c.tiktok.map((u) => <dd><a href={`https://www.tiktok.com/@${u}`} target="_blank" rel="noopener">@{u}</a></dd>)}
    </div>
    <div>
      <dt class="label">WhatsApp</dt>
      <dd><a href={`https://wa.me/${c.whatsapp}`} target="_blank" rel="noopener">{c.whatsappVisible}</a></dd>
    </div>
  </dl>
</section>

<footer class="footer">
  <p>{site.footer}</p>
</footer>

<a class="wa-flotante" href={`https://wa.me/${c.whatsapp}`} target="_blank" rel="noopener" aria-label="Escribime por WhatsApp">
