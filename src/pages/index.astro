---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import QuienSoy from '../components/QuienSoy.astro';
import Categoria from '../components/Categoria.astro';
import Videos from '../components/Videos.astro';
import Cotizacion from '../components/Cotizacion.astro';
import Contacto from '../components/Contacto.astro';
import Lightbox from '../components/Lightbox.astro';
import { site } from '../data/site';

const total = site.categorias.length + 1;
const num = (i: number) => `${String(i).padStart(2, '0')} / ${String(total).padStart(2, '0')}`;
---

<Base>
  <Nav />
  <main id="contenido">
    <Hero />
    <QuienSoy />
    <div id="trabajos" class="trabajos">
      <div class="trabajos__intro">
        <p class="label">Trabajos</p>
        <ul class="trabajos__indice" aria-label="Categorías">
          {site.categorias.map((c) => <li><a href={`#${c.carpeta}`}>{c.titulo}</a></li>)}
          <li><a href="#video">{site.video.titulo}</a></li>
        </ul>
      </div>
      {site.categorias.map((c, i) => <Categoria {...c} numero={num(i + 1)} />)}
      <Videos numero={num(total)} />
    </div>
    <Cotizacion />
    <Contacto />
  </main>
  <Lightbox />
  <script>
    // Fade-in suave al scrollear
    const els = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
      );
      els.forEach((el) => io.observe(el));
    } else {
      els.forEach((el) => el.classList.add('is-visible'));
    }
  </script>
</Base>
