---
import fs from 'node:fs';
import path from 'node:path';
import { Picture } from 'astro:assets';
import { site } from '../data/site';
import { foto } from '../lib/fotos';

interface Props {
  numero: string;
}
const { numero } = Astro.props;
const fondo = foto(site.imagenes.video);

// Reconoce links de YouTube y Vimeo.
function parsear(url: string) {
  const yt = url.match(/(?:youtube\.com\/(?:watch\?(?:.*&)?v=|embed\/|shorts\/|live\/)|youtu\.be\/)([\w-]{11})/);
  if (yt) {
    const id = yt[1];
    return {
      embed: `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&playsinline=1`,
      miniatura: `https://i.ytimg.com/vi/${id}/hqdefault.jpg`,
    };
  }
  const vm = url.match(/vimeo\.com\/(?:.*\/)?(\d+)(?:\/(\w+))?/);
  if (vm) {
    const hash = vm[2] ? `&h=${vm[2]}` : '';
    return {
      embed: `https://player.vimeo.com/video/${vm[1]}?autoplay=1&dnt=1${hash}`,
      miniatura: `https://vumbnail.com/${vm[1]}.jpg`,
    };
  }
  return null;
}

const videos = site.video.lista
  .map((v) => {
    const datos = parsear(v.url);
    return { ...v, datos: datos && { ...datos, miniatura: v.miniatura || datos.miniatura } };
  })
  .filter((v) => v.datos);

// Videos propios: todos los .mp4 de public/videos, en orden alfabético.
// La portada es la imagen con el mismo nombre (.jpg), si existe.
const carpeta = path.join(process.cwd(), 'public', 'videos');
const archivos = fs.existsSync(carpeta) ? fs.readdirSync(carpeta) : [];
const propios = archivos
  .filter((a) => /\.mp4$/i.test(a))
  .sort((a, b) => a.localeCompare(b, 'es', { numeric: true }))
  .map((a) => {
    const base = a.replace(/\.mp4$/i, '');
    const poster = archivos.find((x) => x.toLowerCase() === `${base}.jpg`.toLowerCase());
    const textos = site.video.archivos[a] ?? {};
    const desdeNombre = base.replace(/^[\d\s._-]+/, '').replace(/[-_]+/g, ' ').trim();
    return {
      src: `/videos/${a}`,
      poster: poster ? `/videos/${poster}` : undefined,
      // El título solo se muestra si está escrito en site.ts; si no, se usa el
      // nombre del archivo únicamente para lectores de pantalla.
      titulo: textos.titulo,
      etiqueta: textos.titulo ?? (desdeNombre.charAt(0).toUpperCase() + desdeNombre.slice(1) || 'Video'),
      descripcion: textos.descripcion,
    };
  });
---

<section id="video" class="videos" aria-labelledby="titulo-video">
  <div class:list={['categoria__portada', 'categoria__portada--video', { 'categoria__portada--vacia': !fondo }]}>
    {
      fondo && (
        <div class="categoria__portada-img" aria-hidden="true">
          <Picture src={fondo} alt="" formats={['avif', 'webp']} widths={[640, 1000, 1600]} sizes="100vw" />
        </div>
      )
    }
    <div class="categoria__cabecera reveal">
      <span class="label categoria__numero">{numero}</span>
      <h2 id="titulo-video" class="categoria__titulo">{site.video.titulo}</h2>
      <p class="categoria__bajada">{site.video.bajada}</p>
    </div>
  </div>

  {
    propios.length > 0 && (
      <ul class="videos__propios" role="list">
        {propios.map((v) => (
          <li class="video video--vertical reveal">
            <div class="video__marco">
              <button class="video__play" type="button" data-video={v.src} data-titulo={v.etiqueta}>
                {v.poster && <img src={v.poster} alt="" loading="lazy" decoding="async" width="720" height="1280" />}
                <span class="video__icono" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
                </span>
                <span class="visually-hidden">Reproducir video: {v.etiqueta}</span>
              </button>
            </div>
            {v.titulo && <h3 class="video__titulo">{v.titulo}</h3>}
            {v.descripcion && <p class="video__desc">{v.descripcion}</p>}
          </li>
        ))}
      </ul>
    )
  }
  {
    videos.length > 0 ? (
      <ul class="videos__lista" role="list">
        {videos.map((v) => (
          <li class="video reveal">
            <div class="video__marco">
              <button class="video__play" type="button" data-embed={v.datos!.embed} data-titulo={v.titulo}>
                <img src={v.datos!.miniatura} alt="" loading="lazy" decoding="async" width="480" height="360" />
                <span class="video__icono" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg>
                </span>
                <span class="visually-hidden">Reproducir video: {v.titulo}</span>
              </button>
            </div>
            <h3 class="video__titulo">{v.titulo}</h3>
            {v.descripcion && <p class="video__desc">{v.descripcion}</p>}
          </li>
        ))}
      </ul>
    ) : (
      propios.length === 0 && <p class="categoria__pronto">Nuevos videos muy pronto.</p>
    )
  }
</section>

<script>
  // Carga el reproductor recién cuando se toca "play" (así la página carga rápido).
  document.querySelectorAll<HTMLButtonElement>('.video__play').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (btn.dataset.video) {
        const video = document.createElement('video');
        video.src = btn.dataset.video;
        video.controls = true;
        video.autoplay = true;
        video.playsInline = true;
        video.setAttribute('aria-label', btn.dataset.titulo ?? 'Video');
        const poster = btn.querySelector('img');
        if (poster) video.poster = poster.src;
        btn.replaceWith(video);
        video.play().catch(() => {});
        video.focus();
        return;
      }
      const iframe = document.createElement('iframe');
      iframe.src = btn.dataset.embed!;
      iframe.title = btn.dataset.titulo ?? 'Video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      btn.replaceWith(iframe);
      iframe.focus();
    });
  });
</script>
